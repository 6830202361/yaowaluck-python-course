print("<<<<<<<<<< คำนวณภาษีเงินได้ขั้นบันได >>>>>>>>>>>\n")

# รับค่าเงินได้สุทธิจากผู้ใช้
income = float(input("เงินได้สุทธิ (บาท): "))

# ตัวแปรเก็บภาษีรวม และรายได้ที่เหลือสำหรับคำนวณแต่ละขั้น
tax = 0
remaining = income

# กำหนดช่วงรายได้และอัตราภาษีของแต่ละขั้น
tax_brackets = [
    (150000, 0.00),
    (150000, 0.05),
    (200000, 0.10),
    (250000, 0.15),
    (250000, 0.20),
    (1000000, 0.25),
    (3000000, 0.30),
    (float("inf"), 0.35)
]

# ชื่อช่วงภาษีสำหรับแสดงผล
labels = [
    "0 - 150,000",
    "150,001 - 300,000",
    "300,001 - 500,000",
    "500,001 - 750,000",
    "750,001 - 1,000,000",
    "1,000,001 - 2,000,000",
    "2,000,001 - 5,000,000",
    "มากกว่า 5,000,000 "
]

# เก็บรายละเอียดภาษีของแต่ละช่วง
tax_details = []

# วนลูปคำนวณภาษีทีละขั้น
for i in range(len(tax_brackets)):
    limit, rate = tax_brackets[i]

    # ตรวจสอบว่ายังมีรายได้เหลือให้คำนวณไหม
    if remaining > 0:

        # จำนวนเงินที่ต้องเสียภาษีในขั้นปัจจุบัน
        taxable = min(remaining, limit)

        # คำนวณภาษีของขั้นนี้
        tax_amount = taxable * rate

        # รวมภาษีทั้งหมด
        tax += tax_amount

        # เก็บรายละเอียดภาษีแต่ละช่วง
        tax_details.append((labels[i], tax_amount))

        # หักรายได้ที่คำนวณแล้วออก
        remaining -= taxable
    else:
        # ถ้าไม่มีรายได้ในช่วงนี้ ให้ภาษีเป็น 0
        tax_details.append((labels[i], 0))

# คำนวณรายได้คงเหลือหลังหักภาษี
after_tax = income - tax

# คำนวณอัตราภาษีที่แท้จริง (Effective Tax Rate)
if income > 0:
    effective_rate = (tax / income) * 100
else:
    effective_rate = 0

# แสดงรายละเอียดภาษี
print("\n============== รายละเอียดภาษี ==============")

# แสดงภาษีของแต่ละช่วงและระยะห่าง
for label, amount in tax_details:
    if label == "มากกว่า 5,000,000 ":
        print(f"{label:<26}{amount:>12,.2f} บาท")
    else:
        print(f"{label:<25}{amount:>12,.2f} บาท")

# เส้นคั่น
print("-" * 42)

# แสดงภาษีรวม
print(f"{'ภาษีรวม':<26}{tax:>12,.2f} บาท")

# แสดงรายได้หลังหักภาษี
print(f"{'รายได้หลังหักภาษี':<29}{after_tax:>12,.2f} บาท")

# แสดงอัตราภาษีที่แท้จริง
print(f"Effective Tax Rate = {effective_rate:.2f}%")